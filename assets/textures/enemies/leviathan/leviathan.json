  "behavior": {
    "stages": [
      {
        "name": "warning",
        "trigger": "player enters the edge water",
        "shows": "eyes under the surface and a distant roar"
      },
      {
        "name": "push_back",
        "trigger": "player keeps swimming out",
        "shows": "Attack_3_Tail_Wave shoves the player inland"
      },
      {
        "name": "hunt",
        "trigger": "player ignores the warning",
        "shows": "Emerge, then bite, roar and tentacle attacks"
      },
      {
        "name": "execute",
        "trigger": "player crosses the border",
        "shows": "Attack_2_Devour"
      }
    ],
    "notes": [
      "attacks must read as lethal without any UI warning",
      "most of the body always stays hidden under the water"
    ]
  }
